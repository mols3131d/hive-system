{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "codexcli": {
      "subagents": true,
      "skills": true,
      "gitignoreDestination": "gitexclude"
    },
    "antigravity-ide": {
      "commands": true,
      "subagents": true,
      "skills": true,
      "gitignoreDestination": "gitexclude"
    },
    "antigravity-cli": {
      "commands": true,
      "subagents": true,
      "skills": true,
      // Antigravity skips .gitignore entries; use Git's local exclude instead.
      "gitignoreDestination": "gitexclude"
    }
  },
  "outputRoots": ["."],
  "delete": true,
  "sources": []
}
